# GEMINI_API_KEY: Requerida para llamadas backend a Gemini AI en Express / Node.js
# AI Studio inyecta automáticamente esta variable en tiempo de ejecución.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Opcional para despliegues 100% estáticos en frontend (ej. Vercel estático sin backend).
VITE_GEMINI_API_KEY="MY_VITE_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
